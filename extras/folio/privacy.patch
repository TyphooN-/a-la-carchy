+bool FolderModel::blockPrivateRecents() {
+    if (m_path != recentPath() || folioRecentsEnabled())
+        return false;
+    // Reject cache adoption and late worker publication too. Cancel pending
+    // work, drop this view's watch, and clear visible entries synchronously.
+    ++m_generation;
+    *m_latest = m_generation;
+    m_debounce.stop();
+    if (!m_watcher.files().isEmpty())
+        m_watcher.removePaths(m_watcher.files());
+    recentListings().remove(cacheKey());
+    setSelected({});
+    clearEntries();
+    setError({});
+    setLoading(false);
+    emit loaded();
+    return true;
+}
