@@ -0,0 +1,29 @@
+#include "recentprivacy.h"
+
+#include <gio/gio.h>
+
+bool folioRecentsEnabled() {
+    auto *source = g_settings_schema_source_get_default();
+    auto *schema = source ? g_settings_schema_source_lookup(source, "org.gnome.desktop.privacy", TRUE) : nullptr;
+    // Preserve upstream behavior on desktops without this policy schema.
+    if (!schema)
+        return true;
+    if (!g_settings_schema_has_key(schema, "remember-recent-files")) {
+        g_settings_schema_unref(schema);
+        return true;
+    }
+    auto *key = g_settings_schema_get_key(schema, "remember-recent-files");
+    const bool boolean = g_variant_type_equal(g_settings_schema_key_get_value_type(key), G_VARIANT_TYPE_BOOLEAN);
+    g_settings_schema_key_unref(key);
+    if (!boolean) {
+        g_settings_schema_unref(schema);
+        return true;
+    }
+    // Do not cache a policy value across Stop/Restore. GSettings is already a
+    // Folio dependency; no subprocess, history lookup or settings write occurs.
+    auto *settings = g_settings_new_full(schema, nullptr, nullptr);
+    const bool enabled = g_settings_get_boolean(settings, "remember-recent-files");
+    g_object_unref(settings);
+    g_settings_schema_unref(schema);
+    return enabled;
+}
